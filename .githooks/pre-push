#!/usr/bin/env sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"
python_bin=${PYTHON:-python}

"$python_bin" scripts/check_forbidden_tracked_files.py --root "$root"
"$python_bin" scripts/check_workflow_pins.py --root "$root"
"$python_bin" -m compileall -q src
"$python_bin" -m pytest -q

base=HEAD^
if git rev-parse --verify origin/main >/dev/null 2>&1; then
  base=origin/main
fi
if git diff --name-only "$base"...HEAD | grep -q '^android-broker/'; then
  if [ -x android-broker/gradlew ]; then
    (
      cd android-broker
      ./gradlew testDebugUnitTest lintDebug assembleDebug --dependency-verification strict --no-daemon
    )
  fi
fi
